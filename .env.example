# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# Telegram admin IDs allowed to use /admin, /users, /ban, /unban
# Comma-separated Telegram numeric IDs, e.g. ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Proxy (for Russia - uncomment if needed)
HTTP_PROXY=socks5://127.0.0.1:10808
HTTPS_PROXY=socks5://127.0.0.1:10808

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telegram_task_checker
DB_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Google Sheets
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Debug mode
DEBUG=false
