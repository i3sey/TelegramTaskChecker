# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# Telegram admin IDs allowed to use /admin, /users, /ban, /unban
# Comma-separated Telegram numeric IDs, e.g. ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Proxy (for Russia - uncomment if needed)
HTTP_PROXY=socks5://127.0.0.1:10808
HTTPS_PROXY=socks5://127.0.0.1:10808

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telegram_task_checker
DB_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# XLSX export
# Organizer export sends a generated .xlsx file directly in Telegram and needs no extra credentials.

# Groq transcription API
# Examples:
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Legacy aliases (optional)
LLM_API_KEY=
LLM_BASE_URL=
LLM_TRANSCRIPTION_MODEL=whisper-large-v3

# Debug mode
DEBUG=false
